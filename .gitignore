# ── Build outputs ────────────────────────────────────────────────
build/
build*/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe

# ── Visual Studio ────────────────────────────────────────────────
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
ipch/
Backup*/
UpgradeLog*.XML

# ── CMake ────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
_deps/
*.cmake.stamp*

# ── openFrameworks ───────────────────────────────────────────────
# Addons are pulled as submodules; do not commit their contents.
addons/*/
!addons/.gitkeep
obj/
bin/*.dll
bin/*.exe
bin/libs/

# ── Media (lớn — không đưa vào git) ──────────────────────────────
bin/data/media/*
!bin/data/media/.gitkeep
*.mov
*.mp4
*.mkv
*.avi

# ── Runtime artifacts giữ lại cấu trúc, bỏ nội dung ─────────────
bin/data/projects/*
!bin/data/projects/.gitkeep
bin/data/calib/*
!bin/data/calib/.gitkeep

# ── Logs & temp ──────────────────────────────────────────────────
*.log
*.tmp
.DS_Store
Thumbs.db

# ── bin/ : chi commit tai nguyen ung dung CAN de chay ─────────────
#
# bin/data/fonts/ PHAI vao repo: thieu no thi giao dien mat het dau
# tieng Viet tren may vua clone. Nhung thu duoi day thi khong:
bin/data/media/          # 1.9 GB video thu nghiem, tao lai bang ffmpeg
bin/data/perf.log        # do dac lan chay, khac nhau moi may
bin/imgui.ini            # vi tri cua so, rieng tung nguoi

# settings.json CO CHU DICH khong vao repo. No mo ta MAY NAY va NGUOI
# NAY - ngon ngu giao dien, man hinh nao lam output. Commit no vao thi
# dong nghiep clone ve se bi doi ngon ngu va bi day output ra mot man
# hinh khong ton tai. Day chinh la ly do no tach khoi file project.
bin/data/settings.json

# ── .claude/ : cung ly do nhu tren, ap dung cho cau hinh Claude Code ──
#
# CLAUDE.local.md va settings.local.json mo ta MAY NAY va NGUOI NAY
# (duong dan cuc bo, thiet bi sensor test tai cho, override rieng).
.claude/CLAUDE.local.md
.claude/settings.local.json

# .claude-flow/ : trang thai phien lam viec cua cong cu agent (session, status,
# insights) - thay doi moi lan chay, khong phai cau hinh chung cua du an.
.claude-flow/

# pose_bridge: model tai ve luc chay lan dau + venv cua nguoi dung
tools/pose_bridge/*.task
tools/pose_bridge/*.task.part
tools/pose_bridge/.venv/
__pycache__/
