{
  // ══════════════════════════════════════════════════════════════════════
  //  F5 = chay app. Chon cau hinh o thanh Run and Debug.
  //
  //  Dung "cppvsdbg" (trinh go roi cua Visual Studio) chu khong phai
  //  "cppdbg"/gdb — code bien dich bang MSVC, thong tin go roi la PDB.
  // ══════════════════════════════════════════════════════════════════════
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App: Chay (Release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/HexMapping.exe",
      "args": [],
      "cwd": "${workspaceFolder}/bin",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "App: Build (Release)"
    },
    {
      "name": "App: Chay demo (mock sensor + auto-calibrate)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/HexMapping.exe",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}/bin",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "App: Build (Release)"
    },
    {
      "name": "App: Go roi (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      // Build Debug cua oF doi ten thanh *_debug.exe.
      "program": "${workspaceFolder}/bin/HexMapping_debug.exe",
      "args": [],
      "cwd": "${workspaceFolder}/bin",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "App: Build (Debug)"
    },
    {
      "name": "Core: Go roi unit test",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/hexmap_tests.exe",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "Core: Build tests"
    }
  ]
}
