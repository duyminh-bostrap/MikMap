// STREAMING_CHUNK: Vanilla Script xử lý tương tác...
script.
  // 1. Kích hoạt Render Lucide Icons
  lucide.createIcons();

  // 2. Xử lý Logic chuyển Tab giữa các phân vùng
  const tabBtns = document.querySelectorAll('.tab-btn');
  const views = document.querySelectorAll('.view-section');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Xóa class active của tất cả tabs
      tabBtns.forEach(b => {
        b.classList.remove('active-tab', 'bg-[#1a1a1a]', 'text-primary', 'border-[#333]');
        b.classList.add('text-gray-500', 'border-transparent');
        b.style.boxShadow = 'none';
      });
      
      // Ẩn tất cả các màn hình
      views.forEach(v => v.classList.remove('active'));

      // Kích hoạt tab hiện tại
      btn.classList.add('active-tab', 'bg-[#1a1a1a]', 'text-primary', 'border-[#333]');
      btn.classList.remove('text-gray-500', 'border-transparent');
      btn.style.boxShadow = '0 0 10px rgba(255,127,80,0.1)';
      
      const target = btn.getAttribute('data-target');
      document.getElementById(target).classList.add('active');
    });
  });

  // 3. Xử lý vẽ Radar bằng HTML5 Canvas theo thời gian thực (60FPS)
  const canvas = document.getElementById('radarCanvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let time = 0;
    
    const draw = () => {
      const width = canvas.width;
      const height = canvas.height;
      const cx = width / 2;
      const cy = height / 2;
      const radius = Math.min(width, height) / 2 - 40;

      // Xóa khung nền thành đen sâu
      ctx.fillStyle = '#050505';
      ctx.fillRect(0, 0, width, height);
      
      // Vẽ Lưới tọa độ hệ cực (Polar Grid) - Màu Info Blue
      ctx.strokeStyle = 'rgba(17,138,178,0.15)';
      ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        ctx.beginPath();
        ctx.arc(cx, cy, (radius / 4) * i, 0, 2 * Math.PI);
        ctx.stroke();
        ctx.fillStyle = 'rgba(17,138,178,0.4)';
        ctx.font = '10px monospace';
        ctx.fillText(`${i}m`, cx + (radius/4)*i + 5, cy + 12);
      }
      ctx.beginPath();
      ctx.moveTo(cx - radius, cy); ctx.lineTo(cx + radius, cy);
      ctx.moveTo(cx, cy - radius); ctx.lineTo(cx, cy + radius);
      ctx.stroke();

      // Vẽ Vùng mặt nạ tương tác (ROI Polygon) - Màu Primary Orange
      const roiPoints = [{x: cx-180, y: cy-120}, {x: cx+200, y: cy-150}, {x: cx+220, y: cy+160}, {x: cx-140, y: cy+220}];
      ctx.strokeStyle = '#FF7F50';
      ctx.fillStyle = 'rgba(255,127,80,0.05)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(roiPoints[0].x, roiPoints[0].y);
      roiPoints.forEach(p => ctx.lineTo(p.x, p.y));
      ctx.closePath();
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#FF7F50';
      ctx.font = 'bold 10px sans-serif';
      ctx.fillText("ROI_ZONE_1", roiPoints[0].x + 10, roiPoints[0].y + 20);

      // Tạo Tia Radar đang quét - Màu Warning Yellow
      const sweepAngle = (time * 2) % (Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,209,102,0.8)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(sweepAngle) * radius, cy + Math.sin(sweepAngle) * radius);
      ctx.stroke();
      
      ctx.fillStyle = 'rgba(255,209,102,0.1)';
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, radius, sweepAngle, sweepAngle - 0.4, true);
      ctx.fill();

      // Giả lập điểm người đang di chuyển (Blob Tracking)
      time += 0.02;
      const blobX = cx + Math.sin(time * 0.8) * 120 + 20;
      const blobY = cy + Math.cos(time * 1.2) * 80;
      
      ctx.strokeStyle = '#FF7F50';
      ctx.fillStyle = '#FF7F50';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(blobX - 15, blobY); ctx.lineTo(blobX + 15, blobY);
      ctx.moveTo(blobX, blobY - 15); ctx.lineTo(blobX, blobY + 15);
      ctx.stroke();
      
      // Điểm giữa nhấp nháy
      if (Math.floor(time * 4) % 2 === 0) {
        ctx.beginPath(); ctx.arc(blobX, blobY, 4, 0, Math.PI * 2); ctx.fill();
      }
      
      // Khung viền Blob Bounding Box (Success Green)
      ctx.strokeStyle = '#06D6A0';
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 2]);
      ctx.strokeRect(blobX - 20, blobY - 20, 40, 40);
      ctx.setLineDash([]);
      
      // Text Readout
      ctx.fillStyle = '#E0E0E0';
      ctx.font = '11px monospace';
      ctx.fillText(`ID:01`, blobX + 25, blobY - 10);
      ctx.fillStyle = '#06D6A0';
      ctx.fillText(`X:${Math.round(blobX-cx)} Y:${Math.round(cy-blobY)}`, blobX + 25, blobY + 5);

      // Chạy vòng lặp Render
      requestAnimationFrame(draw);
    };
    draw();
  }
