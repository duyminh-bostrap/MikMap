// STREAMING_CHUNK: Không Gian Làm Việc (Workspaces)...
div(class="flex-grow w-full overflow-hidden flex relative")
  
  // ==========================================
  // VIEW 1: COMPOSITION (Main VJ UI)
  // ==========================================
  div(id="comp" class="view-section active w-full h-full flex-col bg-[#0a0a0a]")
    div(class="flex h-[50%] min-h-[300px] w-full shrink-0 border-b border-border")
      // Browser
      div(class="w-[220px] flex flex-col bg-bgPanel border-r border-border shrink-0")
        div(class="p-2 border-b border-border flex items-center justify-between bg-bgCard")
          span(class="text-[10px] font-bold tracking-widest text-gray-300") FILES & EFFECTS
          i(data-lucide="folder-open" class="w-3 h-3 text-gray-500")
        div(class="p-3 flex-grow overflow-y-auto")
          each folder in ['Generators', 'VJ_Loops', 'Audio_React', 'Masks']
            div(class="flex items-center gap-2 py-1.5 text-[11px] text-gray-500 hover:text-gray-200 cursor-pointer transition-colors")
              i(data-lucide="chevron-right" class="w-3 h-3")
              i(data-lucide="folder-open" class="w-3 h-3 text-info")
              span(class="truncate")= folder
          div(class="mt-4 pt-3 border-t border-border")
            div(class="text-[9px] font-bold text-gray-600 mb-2 uppercase tracking-widest") Video Effects
            each fx in ['Colorize', 'Glow', 'Hue Rotate', 'Pixelate']
              div(class="flex items-center gap-2 py-1 text-[11px] text-gray-400 hover:text-white cursor-pointer pl-4")
                i(data-lucide="sliders" class="w-2.5 h-2.5 text-warning")
                | #{fx}
      
      // Monitors
      div(class="flex-grow flex bg-[#050505] p-2 gap-2")
        // Preview
        div(class="flex-1 flex flex-col bg-bgPanel border border-border rounded overflow-hidden")
          div(class="h-5 bg-bgCard flex items-center px-3 border-b border-border border-t-2 border-t-info")
            span(class="text-[9px] font-bold tracking-widest text-info") PREVIEW
          div(class="flex-grow relative flex flex-col items-center justify-center p-4")
            div(class="w-full h-full border border-dashed rounded flex flex-col items-center justify-center gap-2 text-gray-700 bg-[#0a0a0a]" style="border-color: rgba(17,138,178,0.3)")
              i(data-lucide="monitor" class="w-6 h-6 text-info opacity-50 mb-1")
              span(class="font-mono text-[10px] font-bold px-2 py-0.5 rounded border border-info text-info" style="background-color: rgba(17,138,178,0.1)") L3 - CLIP 02
        // Live Output
        div(class="flex-1 flex flex-col bg-bgPanel border border-border rounded overflow-hidden shadow-lg")
          div(class="h-5 bg-bgCard flex items-center justify-between px-3 border-b border-border border-t-2 border-t-primary")
            span(class="text-[9px] font-bold tracking-widest flex items-center gap-2 text-primary")
              div(class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse" style="box-shadow: 0 0 5px currentColor")
              | LIVE OUTPUT
          div(class="flex-grow relative flex items-center justify-center overflow-hidden bg-black")
            div(class="w-[80%] h-[80%] border rounded flex items-center justify-center relative" style="border-color: rgba(255,127,80,0.2); background-color: rgba(255,127,80,0.05); box-shadow: 0 0 30px rgba(255,127,80,0.1)")
              div(class="absolute inset-0 mix-blend-screen" style="background: linear-gradient(to top right, rgba(17,138,178,0.3), rgba(6,214,160,0.1))")
              div(class="absolute bottom-2 right-2 font-mono text-[9px] bg-black/50 px-1 rounded text-primary") 1920x1080
      
      // Properties
      div(class="w-[250px] flex flex-col bg-bgPanel border-l border-border shrink-0")
        div(class="flex bg-bgCard border-b border-border")
          button(class="flex-1 py-2 text-[9px] font-bold tracking-wider transition-colors text-warning border-b-2 border-warning bg-[#222]") CLIP
          button(class="flex-1 py-2 text-[9px] font-bold tracking-wider transition-colors text-gray-500 hover:bg-[#111]") LAYER 3
        
        div(class="p-4 flex-grow overflow-y-auto")
          div(class="space-y-5")
            // Transport Buttons
            div
              div(class="text-[9px] font-bold text-gray-600 tracking-widest uppercase mb-2") Transport
              div(class="flex items-center justify-between bg-black p-2 rounded-lg border border-border" style="box-shadow: inset 0 2px 5px rgba(0,0,0,0.5)")
                button(class="p-1.5 text-gray-500 hover:text-gray-200 hover:bg-[#222] rounded transition-colors")
                  i(data-lucide="skip-back" class="w-3.5 h-3.5")
                button(class="p-1.5 text-red-500/80 hover:text-red-400 hover:bg-red-900/20 rounded transition-colors")
                  i(data-lucide="square" class="w-3.5 h-3.5")
                button(class="p-2 rounded-full shadow-lg transition-all border border-success bg-success text-success hover:scale-110" style="background-color: rgba(6,214,160,0.1); border-color: rgba(6,214,160,0.8); box-shadow: 0 0 10px rgba(6,214,160,0.3)")
                  i(data-lucide="pause" class="w-4 h-4 fill-current")
                button(class="p-1.5 text-gray-500 hover:text-gray-200 hover:bg-[#222] rounded transition-colors")
                  i(data-lucide="skip-forward" class="w-3.5 h-3.5")
                button(class="p-1.5 rounded transition-colors bg-info text-info" style="background-color: rgba(17,138,178,0.1)")
                  i(data-lucide="repeat" class="w-3.5 h-3.5")
            
            // Sliders Data
            each prop in [{name: 'Timeline', val: '00:12:44', c: 'success', w: '45%'}, {name: 'Scale', val: '100.0%', c: 'primary', w: '50%'}, {name: 'Rotation', val: '0.0°', c: 'info', w: '50%'}]
              div
                div(class="flex justify-between text-[9px] text-gray-500 mb-2 font-bold tracking-wider")
                  span= prop.name
                  span(class=`font-mono text-${prop.c} text-gray-200`)= prop.val
                div(class="h-2 w-full bg-[#030303] rounded-full border border-border relative cursor-pointer group slider-track")
                  div(class=`absolute top-0 left-0 h-full rounded-full bg-${prop.c}` style=`width: ${prop.w}; box-shadow: 0 0 8px currentColor`)
                  div(class="absolute top-1/2 -translate-y-1/2 w-3.5 h-3.5 bg-gradient-to-b from-white to-gray-300 rounded-full border border-gray-600 transition-transform group-hover:scale-125 slider-thumb" style=`left: calc(${prop.w} - 7px)`)

    // Bottom Deck & Grid
    div(class="flex-grow flex flex-col bg-bgPanel overflow-hidden")
      div(class="flex-grow overflow-auto flex relative")
        // Headers
        div(class="sticky left-0 z-20 flex flex-col w-[220px] bg-bgPanel border-r border-border shrink-0" style="box-shadow: 4px 0 15px rgba(0,0,0,0.5)")
          div(class="h-10 bg-[#161616] border-b border-primary/30 shrink-0 flex items-center px-3 gap-3 relative" style="box-shadow: inset 0 1px 5px rgba(0,0,0,0.5)")
            div(class="absolute left-0 top-0 bottom-0 w-[3px] bg-primary" style="box-shadow: 0 0 10px #FF7F50")
            span(class="text-[10px] font-bold shrink-0 tracking-widest w-[40px] text-primary") L3 OP
            div(class="flex-grow h-2.5 bg-[#030303] rounded-full w-full border border-border relative cursor-pointer group slider-track")
              div(class="absolute top-0 left-0 h-full rounded-full" style="background: linear-gradient(90deg, #FFD166, #FF7F50); box-shadow: 0 0 10px rgba(255,127,80,0.6); width: 80%")
              div(class="absolute top-1/2 -translate-y-1/2 w-4 h-4 bg-gradient-to-b from-white to-gray-200 rounded-full border border-gray-500 transition-transform group-hover:scale-125 slider-thumb" style="left: calc(80% - 8px)")
            span(class="text-[10px] font-mono text-primary font-bold w-8 text-right bg-black py-0.5 px-1 rounded border border-gray-800") 80%

          each layer in [3, 2, 1]
            - var isSel = (layer === 3)
            div(class=`h-[90px] p-2.5 shrink-0 flex flex-col justify-between group cursor-pointer transition-colors border-b border-border border-l-2 ${isSel ? 'bg-[#1e1e1e] border-l-primary' : 'bg-[#161616] border-l-transparent hover:bg-bgCard'}`)
              div(class="flex justify-between items-center")
                span(class=`text-xs font-bold font-sans transition-colors ${isSel ? 'text-primary' : 'text-gray-300 group-hover:text-primary'}`) Layer #{layer}
                div(class="flex gap-1")
                  button(class=`w-5 h-5 text-[9px] rounded border transition-colors ${isSel ? 'bg-gray-800 border-gray-500 text-white' : 'bg-[#222] border-gray-800 text-gray-500 hover:bg-gray-800'}`) V
                  button(class="w-5 h-5 bg-[#222] text-[9px] rounded text-gray-500 border border-gray-800 hover:bg-info hover:text-white transition-colors") S
                  button(class="w-5 h-5 bg-[#222] text-[9px] rounded text-gray-500 border border-gray-800 hover:bg-red-900 hover:text-white transition-colors") B
              div(class="mt-2 flex justify-between items-center text-[9px] text-gray-500 font-mono bg-[#111] px-2 py-1.5 rounded border border-gray-800")
                span BLEND
                span(class=`${isSel ? 'text-primary' : 'text-info'}`)= layer === 3 ? 'ADDITIVE' : 'ALPHA'

        // Clip Grid Matrix
        div(class="flex flex-col min-w-max")
          div(class="h-8 bg-bgPanel flex items-center px-1 border-b border-border sticky top-0 z-10 shrink-0")
            each col in [1, 2, 3, 4, 5, 6, 7, 8]
              div(class="min-w-[120px] w-[120px] text-center shrink-0")
                span(class="text-[9px] font-bold text-gray-600 hover:text-gray-300 cursor-pointer") COL #{col}
          
          each layer in [3, 2, 1]
            div(class="flex h-[90px] gap-1 p-1 bg-bgPanel border-b border-border shrink-0")
              each clip in [1, 2, 3, 4, 5, 6, 7, 8]
                - var isLive = (layer === 3 && clip === 2)
                - var isPreview = (layer === 3 && clip === 2)
                - var isLoaded = (layer === 3 && clip < 5) || (layer === 2 && clip === 1)
                
                div(class=`min-w-[120px] w-[120px] shrink-0 rounded flex flex-col overflow-hidden transition-all border ${isLive ? 'border-primary shadow-[0_0_10px_rgba(255,127,80,0.2)]' : isPreview ? 'border-info' : isLoaded ? 'border-gray-800' : 'border-[#1a1a1a]'} ${isPreview ? 'bg-[#222]' : isLoaded ? 'bg-[#222]' : 'bg-[#111]'}`)
                  if isLoaded
                    div(class="flex-grow relative cursor-pointer group bg-black")
                      if isLive
                        div(class="absolute inset-0 opacity-40 mix-blend-screen" style="background: linear-gradient(to bottom right, #FF7F50, #FFD166)")
                        div(class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-primary animate-pulse" style="box-shadow: 0 0 5px currentColor")
                      else
                        div(class="absolute inset-0 opacity-40 mix-blend-screen" style="background: linear-gradient(to top right, #118AB2, #06D6A0)")
                      div(class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity")
                        i(data-lucide="play" class=`w-4 h-4 ${isLive ? 'text-primary' : 'text-white'}`)
                    
                    div(class=`h-5 w-full flex items-center justify-between px-1.5 cursor-pointer border-t group ${isPreview ? 'bg-info border-info text-info' : 'bg-[#161616] border-gray-800 text-gray-500'}` style=`${isPreview ? 'background-color: rgba(17,138,178,0.2); border-color: rgba(17,138,178,0.8)' : ''}`)
                      span(class="text-[9px] font-bold truncate") Clip 0#{clip}
                      i(data-lucide="eye" class=`w-2.5 h-2.5 ${isPreview ? 'opacity-100' : 'opacity-0 group-hover:opacity-100 transition-opacity'}`)
                    
                    if isLive
                      div(class="h-1 w-full bg-gray-800")
                        div(class="h-full opacity-80 bg-primary" style="width: 65%; animation: pulse 2s ease-in-out infinite")
                  else
                    div(class="flex-grow hover:bg-[#161616] cursor-pointer transition-colors")

  // ==========================================
  // VIEW 2: ADVANCED MAPPING
  // ==========================================
  div(id="mapping" class="view-section w-full h-full flex")
    // Tree Left
    div(class="w-[240px] flex flex-col bg-bgPanel border-r border-border shrink-0")
      div(class="p-3 border-b border-border flex items-center justify-between")
        span(class="text-xs font-bold tracking-widest text-gray-300") MAPPING TREE
        i(data-lucide="plus" class="w-3.5 h-3.5 text-gray-500 hover:text-white cursor-pointer")
      div(class="flex-grow overflow-y-auto p-2")
        div(class="flex flex-col gap-1")
          div(class="flex items-center gap-2 py-1.5 px-2 rounded cursor-pointer transition-colors bg-primary text-primary" style="background-color: rgba(255,127,80,0.1)")
            i(data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-500")
            i(data-lucide="monitor" class="w-3.5 h-3.5")
            span(class="text-[11px] font-semibold") Screen 1
          div(class="pl-6 flex flex-col gap-1 border-l border-gray-800 ml-3")
            div(class="flex items-center gap-2 py-1.5 px-2 rounded cursor-pointer transition-colors bg-info text-info" style="background-color: rgba(17,138,178,0.2)")
              i(data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-600")
              i(data-lucide="crop" class="w-3.5 h-3.5")
              span(class="text-[11px]") Center LED Wall
            div(class="pl-6 flex flex-col gap-1 border-l border-gray-800 ml-3")
              div(class="flex items-center gap-2 py-1.5 px-2 rounded cursor-pointer transition-colors text-gray-500 hover:bg-bgCard")
                i(data-lucide="scissors" class="w-3 h-3")
                span(class="text-[11px]") DJ Booth Mask
                i(data-lucide="eye" class="w-3 h-3 ml-auto text-gray-600")
            div(class="flex items-center gap-2 py-1.5 px-2 rounded cursor-pointer transition-colors mt-1 text-gray-400 hover:bg-bgCard")
              i(data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-600")
              i(data-lucide="crop" class="w-3.5 h-3.5")
              span(class="text-[11px]") Left Pillar
    
    // Canvas Center
    div(class="flex-grow flex flex-col bg-[#050505] relative overflow-hidden")
      div(class="absolute top-4 left-4 right-4 flex justify-between z-10 pointer-events-none")
        div(class="flex gap-2 pointer-events-auto bg-bgPanel/90 backdrop-blur-sm border border-border rounded-lg p-1")
          button(class="p-1.5 rounded bg-border text-white")
            i(data-lucide="mouse-pointer-2" class="w-3.5 h-3.5")
          button(class="p-1.5 rounded hover:bg-[#222] text-gray-500")
            i(data-lucide="crop" class="w-3.5 h-3.5")
        div(class="flex pointer-events-auto bg-bgPanel/90 backdrop-blur-sm border border-border rounded-lg p-1 shadow-lg")
          button(class="px-4 py-1.5 rounded text-[10px] font-bold flex items-center gap-2 bg-primary text-primary border border-primary" style="background-color: rgba(255,127,80,0.1); border-color: rgba(255,127,80,0.4); box-shadow: 0 0 10px rgba(255,127,80,0.1)")
            i(data-lucide="layers" class="w-3 h-3")
            | INPUT SELECTION
          button(class="px-4 py-1.5 rounded text-[10px] font-bold flex items-center gap-2 text-gray-500 hover:text-white")
            i(data-lucide="monitor-play" class="w-3 h-3")
            | OUTPUT ROUTING
        div(class="pointer-events-auto")
          button(class="p-2 rounded-lg border backdrop-blur-sm transition-colors bg-bgPanel/90 border-border text-gray-500 hover:text-white")
            i(data-lucide="panel-right-close" class="w-4 h-4")

      div(class="flex-grow w-full h-full flex items-center justify-center p-12")
        div(class="relative border border-gray-800 overflow-hidden transition-all duration-500 w-[80%] h-[70%] bg-[#111]" style="box-shadow: 0 0 50px rgba(0,0,0,0.8); background-image: repeating-linear-gradient(45deg, #1a1a1a 25%, transparent 25%, transparent 75%, #1a1a1a 75%, #1a1a1a), repeating-linear-gradient(45deg, #1a1a1a 25%, #111 25%, #111 75%, #1a1a1a 75%, #1a1a1a); background-size: 20px 20px;")
          div(class="absolute top-2 left-2 text-[10px] font-mono text-gray-600") COMPOSITION 1920x1080
          div(class="absolute border border-dashed flex items-center justify-center border-primary bg-primary" style="top: 20%; left: 20%; width: 60%; height: 60%; background-color: rgba(255,127,80,0.1)")
            span(class="font-sans font-bold text-xs opacity-50 text-primary") Center LED Wall
            each pos in ['-top-1 -left-1', '-top-1 -right-1', '-bottom-1 -left-1', '-bottom-1 -right-1']
              div(class=`absolute ${pos} w-2.5 h-2.5 bg-white border border-gray-800`)
    
    // Properties Right
    div(class="w-[280px] flex flex-col bg-bgPanel border-l border-border shrink-0")
      div(class="p-3 border-b border-border flex items-center gap-2")
        i(data-lucide="settings-2" class="w-3.5 h-3.5 text-gray-500")
        span(class="text-xs font-bold tracking-widest text-gray-300 uppercase") Slice Properties
      div(class="p-4 flex-grow overflow-y-auto")
        div(class="space-y-5")
          div
            label(class="text-[10px] text-gray-500 font-bold tracking-widest mb-2 block") OUTPUT DEVICE
            div(class="bg-black border border-gray-800 p-2 rounded text-xs text-gray-300 flex justify-between items-center cursor-pointer hover:border-gray-500")
              span Display 1 (HDMI)
              i(data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-500")
            div(class="mt-2 text-[10px] font-mono text-gray-500") Resolution: #[span(class="text-gray-300") 1920 x 1080 @ 60Hz]
          div(class="border-t border-border pt-4")
            label(class="text-[10px] text-gray-500 font-bold tracking-widest mb-2 block") EDGE BLENDING
            button(class="w-full py-2 bg-bgCard border border-gray-800 rounded text-[11px] text-gray-500 hover:text-white transition-colors") Enable Blending

  // ==========================================
  // VIEW 3: SENSOR I/O
  // ==========================================
  div(id="sensor" class="view-section w-full h-full flex")
    // Device Manager
    div(class="flex flex-col h-full bg-bgPanel border-r border-border w-[240px] shrink-0")
      div(class="p-4 border-b border-border flex items-center justify-between")
        h2(class="text-gray-300 font-semibold text-xs tracking-widest flex items-center gap-2")
          i(data-lucide="cpu" class="w-3.5 h-3.5 text-info")
          | DEVICE MANAGER
        i(data-lucide="settings-2" class="w-3.5 h-3.5 text-gray-500 cursor-pointer hover:text-white")
      div(class="p-4 flex-grow overflow-y-auto")
        div(class="bg-bgCard border border-border rounded-lg p-3 mb-4 transition-all hover:border-warning/50")
          div(class="flex justify-between items-start mb-3")
            div
              h3(class="text-gray-300 text-sm font-medium") Hokuyo UST-10LX
              p(class="text-gray-500 text-xs font-mono mt-0.5") 192.168.1.10:10940
            div(class="w-2.5 h-2.5 rounded-full mt-1 bg-success" style="box-shadow: 0 0 8px #06D6A0")
          div(class="flex items-center justify-between text-[11px] text-gray-500 font-mono mb-4 bg-black rounded px-2 py-1.5 border border-border")
            span 2D LiDAR
            span 40Hz
          button(class="w-full py-2.5 rounded text-xs font-bold flex items-center justify-center gap-2 border bg-primary text-primary border-primary transition-colors" style="background-color: rgba(255,127,80,0.1); border-color: rgba(255,127,80,0.4); box-shadow: 0 0 15px rgba(255,127,80,0.2)")
            i(data-lucide="power" class="w-3.5 h-3.5")
            | CONNECTED
        button(class="w-full py-4 rounded-lg border border-dashed border-border text-gray-500 text-xs hover:text-info hover:border-info flex flex-col items-center justify-center gap-2 bg-[#0a0a0a] transition-colors")
          div(class="p-2 rounded-full bg-bgCard")
            i(data-lucide="activity" class="w-4 h-4")
          | ADD NEW SENSOR
